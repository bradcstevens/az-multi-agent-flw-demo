# The `macae-flw-v1` environment's provisioning inputs.
#
# Every `${...}` substitution in `infra/main.parameters.json` that has no
# `=default` is read from the azd environment, and until this file existed the
# only copy of those values was `.azure/macae-flw-v1/.env` — gitignored, on one
# laptop. That is a poor place for the inputs of the environment a demonstration
# runs on, and it is also why an unattended deploy could not exist: a runner
# starts with an empty azd environment.
#
# Three of these are the reason this file is load-bearing rather than
# convenient. `AZURE_ENV_BACKEND_IMAGE_NAME`, `AZURE_ENV_FRONTEND_IMAGE_NAME`
# and `AZURE_ENV_MCP_IMAGE_NAME` default to `azuredocs/containerapps-helloworld`
# — the **Placeholder image**, which listens on 80 against ingress ports of
# 8000, 9000 and 3000, never produces a ready revision, and stalls the whole
# `mcp -> backend -> frontend` chain for twenty minutes before ARM gives up.
# That is the failure commit `6a7199a5` diagnosed. A deploy that forgot these
# would not fail loudly; it would reinstate the placeholder.
#
# `src/tests/ci/test_deploy_workflow.py` asserts this file names every
# substitution in `main.parameters.json` that has no default, so a new
# parameter cannot be added without either a default or a value here.
#
# Not here, deliberately:
#   AZURE_ENV_IMAGE_TAG                        - the commit being deployed, so
#                                                the workflow computes it.
#   COPILOT_STUDIO_DIRECT_LINE_TOKEN_ENDPOINT  - a capability URL that issues
#                                                Direct Line tokens for an
#                                                agent whose authentication
#                                                mode is None. It is a
#                                                repository secret. See ADR-020.

AZURE_ENV_NAME=macae-flw-v1
AZURE_ENV_DEPLOYMENT_FLAVOR=bicep

# Regions. The search service is not in the solution's region: `centralus` is
# where semantic search capacity was available.
AZURE_LOCATION=eastus2
AZURE_ENV_AI_SERVICE_LOCATION=eastus2
AZURE_ENV_SEARCH_SERVICE_LOCATION=centralus

# The model roster, as deployed. `deployed-environment.md` proves each of these
# answers a real request; changing one here re-deploys it on the next push.
AZURE_ENV_MODEL_DEPLOYMENT_TYPE=GlobalStandard
AZURE_ENV_GPT_MODEL_NAME=gpt-5.4-mini
AZURE_ENV_GPT_MODEL_VERSION=2026-03-17
AZURE_ENV_GPT_MODEL_CAPACITY=100
AZURE_ENV_MODEL_5_4_DEPLOYMENT_TYPE=GlobalStandard
AZURE_ENV_MODEL_5_4_NAME=gpt-5.4
AZURE_ENV_MODEL_5_4_VERSION=2026-03-05
AZURE_ENV_MODEL_5_4_CAPACITY=150
AZURE_ENV_EMBEDDING_MODEL_NAME=text-embedding-3-small
AZURE_ENV_EMBEDDING_MODEL_VERSION=1
AZURE_ENV_EMBEDDING_MODEL_DEPLOYMENT_TYPE=GlobalStandard
AZURE_ENV_EMBEDDING_MODEL_CAPACITY=120

# The registry and the three image names. See the note above: the defaults for
# the image names are the Placeholder image.
AZURE_ENV_CONTAINER_REGISTRY_ENDPOINT=crmacaeflwv1flrpd.azurecr.io
AZURE_ENV_BACKEND_IMAGE_NAME=macaebackend
AZURE_ENV_FRONTEND_IMAGE_NAME=macaefrontend
AZURE_ENV_MCP_IMAGE_NAME=macaemcp

AZURE_ENV_ENABLE_TELEMETRY=true

# The Copilot Studio agent the SOP tool reaches. The name is a label the
# backend reports; the endpoint that reaches it is the secret above.
COPILOT_STUDIO_AGENT_NAME=Store SOP Assistant

# Empty on this environment, and named anyway so the parameter surface is
# stated in full: both are "bring your own resource" inputs this deployment
# does not use, and azd substitutes an unset variable as an empty string.
AZURE_ENV_EXISTING_LOG_ANALYTICS_WORKSPACE_RID=
AZURE_EXISTING_AIPROJECT_RESOURCE_ID=
